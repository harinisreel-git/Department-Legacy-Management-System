# ==============================================================================
# Department Legacy Management System - Environment Configuration
# Copy this file to .env and configure values before starting the application.
# IMPORTANT: NEVER commit your actual .env file or production secrets to Git!
# ==============================================================================

# Server Network Configuration
PORT=3000
NODE_ENV=production

# JWT Authentication Secret Key
# Required in production. Use a strong, random 32+ character key.
DLMS_SECRET_KEY=replace-with-a-secure-random-32-character-secret-in-production

# Supabase PostgreSQL Integration (Optional)
# If provided, the system persists data to Supabase. If omitted, the system
# automatically operates in high-performance in-memory mode with full seed data.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key

# Google Gemini AI Assistant Integration (Optional)
# If provided, enables live Google Gemini conversational AI with grounded department context.
# If omitted, the system automatically falls back to the embedded grounded expert assistant.
GEMINI_API_KEY=your-gemini-api-key

# Integration Test Suite Target (Optional, defaults to http://127.0.0.1:3000)
# TEST_BASE_URL=http://127.0.0.1:3000

